# *_TMP_PATH is where the temporary db dump is written on the remote. Cloudnet
# hosts have /mnt/persist; on hosts without it (e.g. Oderland) set this to a
# writable path such as /home/<user>/tmp. Defaults to /tmp if left unset.
PROD_USER=root
PROD_HOST={{cookiecutter.ssh_host_prod}}
PROD_SRC_PATH=/mnt/persist/www/{{cookiecutter.deploy_dir}}/current
PROD_UPLOAD_PATH=/mnt/persist/www/{{cookiecutter.deploy_dir}}/shared/src/app/uploads
PROD_TMP_PATH=/mnt/persist/tmp
PROD_DOMAIN={{cookiecutter.domain_prod}}

STAGE_USER=root
STAGE_HOST={{cookiecutter.ssh_host_stage}}
STAGE_SRC_PATH=/mnt/persist/www/{{cookiecutter.deploy_dir}}/current
STAGE_UPLOAD_PATH=/mnt/persist/www/{{cookiecutter.deploy_dir}}/shared/src/app/uploads
STAGE_TMP_PATH=/mnt/persist/tmp
STAGE_DOMAIN={{cookiecutter.domain_stage}}

LOCAL_DOMAIN={{cookiecutter.domain_prod}}.test:{{cookiecutter.docker_web_port}}
# Used when answering "Use SSL locally?" — the https host:port for local dev.
SSL_LOCAL_DOMAIN={{cookiecutter.domain_prod}}.test:{{cookiecutter.docker_web_ssl_port}}
